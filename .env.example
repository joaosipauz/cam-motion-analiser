# Copie este arquivo para .env e ajuste. O docker compose le o .env sozinho.

# Pasta com as gravacoes das cameras (no Windows use barras normais: D:/Gravacoes)
CMA_VIDEOS=./videos

# Onde o app guarda banco, analises e trechos salvos
CMA_DATA=./data

# Porta da interface: http://localhost:8971
CMA_PORT=8971
